#!/bin/sh
set -eu

image="${INCR_IMAGE:-ghcr.io/atlas-brown/incr:latest}"
work_dir="$(pwd)"

if ! command -v docker >/dev/null 2>&1; then
    echo "docker is required to run incr" >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    echo "Usage: incr <script> [script args...]" >&2
    exit 1
fi

cache_dir="${INCR_CACHE_DIR:-$work_dir/.incr-cache}"
mkdir -p "$cache_dir"

docker_tty_flags=""
if [ -t 0 ] && [ -t 1 ]; then
    docker_tty_flags="-it"
elif [ -t 0 ]; then
    docker_tty_flags="-i"
fi

exec docker run --rm ${docker_tty_flags} --privileged \
    -v "$work_dir:$work_dir" \
    -v "$cache_dir:$cache_dir" \
    -w "$work_dir" \
    -e INCR_CACHE_DIR="$cache_dir" \
    "$image" \
    /app/src/incr.sh "$@"
