#!/bin/sh
set -eu

IMAGE="${INCR_IMAGE:-incr}"
REPO_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WORK_DIR="$(pwd)"

if ! command -v docker >/dev/null 2>&1; then
    echo "docker is required to run incr" >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    echo "Usage: incr <script> [script args...]" >&2
    exit 1
fi

cache_dir="${INCR_CACHE_DIR:-$WORK_DIR/.incr-cache}"
mkdir -p "$cache_dir"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    docker build -t "$IMAGE" "$REPO_DIR"
fi

docker_tty_flags=""
if [ -t 0 ] && [ -t 1 ]; then
    docker_tty_flags="-it"
elif [ -t 0 ]; then
    docker_tty_flags="-i"
fi

exec docker run --rm ${docker_tty_flags} --privileged \
    -v "$WORK_DIR:$WORK_DIR" \
    -v "$cache_dir:$cache_dir" \
    -w "$WORK_DIR" \
    -e INCR_CACHE_DIR="$cache_dir" \
    "$IMAGE" \
    /app/incr.sh "$@"
